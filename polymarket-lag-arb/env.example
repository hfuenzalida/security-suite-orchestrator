# Required: YES outcome token id (decimal string from Polymarket UI / Gamma API)
POLYMARKET_YES_TOKEN_ID=

# Live trading: 0x... private key for the wallet that holds USDC on Polygon (never commit real keys)
POLYMARKET_PRIVATE_KEY=

# RTDS symbol for CEX spot (Polymarket RTDS uses lowercase like btcusdt)
PM_ARB_CEX_SYMBOL=btcusdt

# Rolling reference window: CEX "ref" price resets on this horizon for log-return signal
PM_ARB_REF_HORIZON_MS=2000

# Minimum (fair - mid) edge before firing (e.g. 0.03 = 3 percentage points)
PM_ARB_MIN_EDGE=0.03

# Logistic mapping strength from short-horizon CEX log-return to fair probability
PM_ARB_K_RETURN=12

# Drop Polymarket book updates older than this (stale book protection)
PM_ARB_MAX_BOOK_STALE_MS=750

# Drop signals when CEX/RTDS price is older than this (fail closed on feed stalls)
PM_ARB_MAX_CEX_STALE_MS=2000

# Extra edge required when CEX tick is newer than last PM book update (lag regime tuning)
PM_ARB_LAG_EDGE_BOOST=0.0

# FOK buy notional (USDC)
PM_ARB_ORDER_USDC=5

# Hard ceiling for FOK buy price (also bound at submit by ask + max ask slip and fair - min edge)
PM_ARB_WORST_PRICE=0.99

# Max absolute price above best ask allowed at submit time
PM_ARB_MAX_ASK_SLIP=0.02

# Minimum time between signals
PM_ARB_COOLDOWN_MS=1500

# Set to 1 to only evaluate when the latest CEX tick is newer than the PM book snapshot
PM_ARB_ONLY_WHEN_CEX_NEWER=0

# Set to 1 to enable posting (also pass --live); requires allowances on Polygon
PM_ARB_LIVE=0
